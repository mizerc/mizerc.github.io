/* HEADING AND PARAGRAPH COLOR */
:root {
  --paragraph-color: #050505;
  --heading-1-color: #0e5803;
  --heading-2-color: #9c2119;
  --heading-3-color: #B42318;
  --heading-4-color: #E76F51;
  --heading-5-color: #D9467A;
  --heading-6-color: #7C4D9E;
}

:root[data-theme="dark"] {
  --paragraph-color: #e0e0e0;
  --heading-1-color: #cd5a34;
  --heading-2-color: #cd5a34;
  --heading-3-color: #FF7849;
  --heading-4-color: #FFB547;
  --heading-5-color: #F06A9B;
  --heading-6-color: #B58AD6;
}


/* IMPORT HEADING FONT AND MAP IT TO myFont */
@font-face {
  font-family: MYHEADINGFONT;
  /* src: url(./RobotoSlab-Regular.ttf); */
  src: url(./OpenSans_Condensed-Medium.ttf);
}

/* IMPORT PARAGRAPH FONT */
@font-face {
  font-family: MYPARAGRAPHFONT;
  src: url(./Geist-Regular.ttf);
}

