/* IMPORT HEADING FONT AND MAP IT TO myFont */
@font-face {
  font-family: MYHEADINGFONT;
  /* src: url(./RobotoSlab-Regular.ttf); */
  src: url(./OpenSans_Condensed-Medium.ttf);
}

/* IMPORT PARAGRAPH FONT */
@font-face {
  font-family: MYPARAGRAPHFONT;
  src: url(./Geist-Regular.ttf);
}

